ADMIN_NAME=Salim
ADMIN_EMAIL=salim@gmail.com
ADMIN_PASSWORD=testpassword123
JWT_KEY=jwtrandomkey
ENVIRONMENT=production

# Browser API base URL — leave empty to call the API on the same origin as the app.
# Only set it when the API is hosted on another domain (that domain then has to
# answer the CORS preflight, otherwise every request hangs in the browser).
NEXT_PUBLIC_API_URL=

# Prisma / calendar. Since Prisma 7 the URL lives in prisma.config.ts, not in the
# schema. Paths are relative to the project root: the gitignored ./data/dev.db —
# use file:/absolute/path/app.db for a mounted volume.
DATABASE_URL="file:./data/dev.db"
