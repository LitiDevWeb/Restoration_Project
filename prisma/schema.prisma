// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}

model Unavailabilities {
  id    Int    @id @default(autoincrement())
  // SQLite with the Prisma 4.x connector has no native enum or Json support, so
  // the booking type is validated in TypeScript (@webapp/types/unavailability)
  // and the payload is stored as a JSON string. Both columns are plain TEXT.
  type  String
  value String
}