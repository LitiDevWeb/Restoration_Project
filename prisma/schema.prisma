// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  // The Prisma 7 `prisma-client` generator always emits source files into the app
  // tree (there is no node_modules fallback), so `output` is mandatory here: omitting
  // it fails `prisma generate` with "An output path is required". The path is relative
  // to this schema directory, and `src/lib/prisma.ts` imports the result through the
  // `@webapp/*` alias as `@webapp/generated/prisma/client`. The folder is gitignored
  // and rebuilt by the `postinstall` script.
  output = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  // Prisma 7 no longer allows `url` here: the CLI reads it from ../prisma.config.ts
}

model Admin {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}

model Unavailabilities {
  id    Int    @id @default(autoincrement())
  // Prisma's SQLite connector supports neither `enum` nor `Json` columns, so
  // the booking type is validated in TypeScript (@webapp/types/unavailability)
  // and the payload is stored as a JSON string. Both columns are plain TEXT.
  type  String
  value String
}